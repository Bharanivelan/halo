# Copy to .env and fill in. Never commit .env.

# ── Database (docker compose db service on localhost:5433) ──
DB_OWNER_PASSWORD=inhabitr_owner_dev
DB_APP_PASSWORD=inhabitr_app_dev
DATABASE_URL=postgresql+psycopg://inhabitr_app:inhabitr_app_dev@localhost:5433/inhabitr
DATABASE_OWNER_URL=postgresql+psycopg://inhabitr_owner:inhabitr_owner_dev@localhost:5433/inhabitr

# ── App ──
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Self-service sign-up at /signup (D-51). false = invite-only: accounts come from `python -m app.cli add-user`.
SIGNUP_ENABLED=true

# ── AI (recommended: research, signal extraction and outreach drafting) ──
# Without it the pipeline still runs on OpenStreetMap data + rules, but research quality is limited.
# LLM_PROVIDER: gemini (default) | openai | bedrock | openai_compatible   (README: "Choose an AI provider")
LLM_PROVIDER=gemini
# Model names. Leave empty for the provider default:
#   gemini: gemini-2.5-flash   openai: gpt-5-mini   bedrock: amazon.nova-lite-v1:0 (fast) / amazon.nova-pro-v1:0 (standard)
#   openai_compatible: no default, set at least LLM_MODEL_FAST
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
# LLM_MAX_RPM: requests per minute your key allows (0 = unlimited). Free Gemini keys: ~10, so use 8.
LLM_MAX_RPM=0

# gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# openai
OPENAI_API_KEY=

# bedrock (Amazon Bedrock). Credentials: set ONE of the options below, or leave all empty to use the
# standard AWS chain (env vars, ~/.aws profile or SSO login, container or instance role).
# Enable access to your models in the Bedrock console (Model access) for this region first.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# A Bedrock API key (Bedrock console -> API keys) also works:
AWS_BEARER_TOKEN_BEDROCK=

# openai_compatible: any server with an OpenAI-style /chat/completions endpoint, e.g.
#   OpenRouter https://openrouter.ai/api/v1   Groq https://api.groq.com/openai/v1   Together https://api.together.xyz/v1
#   Ollama http://localhost:11434/v1 (no key)   LM Studio http://localhost:1234/v1 (no key)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Web search (optional; improves website discovery and news coverage) ──
TAVILY_API_KEY=

# ── Public tunnel for the Lovable app (scripts/tunnel.ps1). Free static domain from dashboard.ngrok.com ──
NGROK_DOMAIN=

# ── First agent run when a project is created (D-40). Kept small: it spends AI credit without a click ──
AUTOSTART_MAX_COMPANIES=50
AUTOSTART_BUDGET_USD=2.0

# ── Identification sent to public data services (Nominatim, Overpass, GDELT, websites) ──
HTTP_USER_AGENT=HaloBot/0.1 (B2B account research; respects robots.txt)
